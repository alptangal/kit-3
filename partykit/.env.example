# ĐÃ CHUYỂN SANG PartyServer (Cloudflare Workers) — file này giữ lại để
# tham chiếu lịch sử; cấu hình local dev giờ là wrangler.jsonc + .dev.vars.
#
# Token bảo vệ endpoint push public key (POST /parties/main/server-keys).
# - Local dev: copy giá trị vào partykit/.dev.vars (wrangler dev tự đọc,
#   override "vars" trong wrangler.jsonc).
# - Production: `npx wrangler secret put PARTYKIT_INTERNAL_TOKEN`
# PHẢI trùng với giá trị PARTYKIT_INTERNAL_TOKEN trong .env của root SvelteKit
# (dòng 44) vì SvelteKit push kèm Bearer token này.
PARTYKIT_INTERNAL_TOKEN=change-me
