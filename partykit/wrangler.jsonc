// Wrangler config cho realtime server chạy trên Cloudflare Workers
// (PartyServer — package chính thức của Cloudflare thay thế partykit).
//
// KHÔNG đặt secret thật trong file này — nó được commit. Token
// PARTYKIT_INTERNAL_TOKEN chỉ là placeholder "vars" cho local dev
// (wrangler dev override qua .dev.vars); production set qua
// `npx wrangler secret put PARTYKIT_INTERNAL_TOKEN`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kit3-realtime",
	"main": "src/server.ts",
	"compatibility_date": "2026-08-25",
	// PARTYKIT_INTERNAL_TOKEN set qua `npx wrangler secret put` (prod)
	// và override qua .dev.vars (local dev) — không đặt trong vars để
	// tránh xung đột binding name với secret.
	"durable_objects": {
		"bindings": [
			{
				"name": "Main",
				"class_name": "Main"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Main"]
		}
	]
}
