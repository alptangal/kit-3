partykit/build/
partykit/public/dist/
partykit/.partykit/
partykit/.env
partykit/.dev.vars
partykit/.wrangler/
.env

# Kho lưu tạm (script debug/scratch từ các phiên) — không theo dõi
tests/_scratch/

# Log runtime server + report Playwright chạy cục bộ (nội dung sinh mỗi phiên)
dev-server.log
dev-server-run.log
dev-server.err.log
last_ssr_error.log
playwright-report/

# Ảnh ad-hoc cho ui-checker sinh mỗi lần chạy probe (không track)
test-results/
