		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24",
		"@unocss/preset-mini": "^66.6.6",
		"@unocss/preset-wind4": "^66.6.6",
		"@unocss/svelte-scoped": "^66.6.6",
		"@vitest/browser-playwright": "^4.0.18",
		"autoprefixer": "^10.4.27",
